# Copy this file to `secrets.local` in your opencode config directory
# (default: ~/.config/opencode/secrets.local) and add literal secret
# values you want scrubbed from every outbound prompt.
#
#   - One value per line.
#   - Blank lines and lines starting with "#" are ignored.
#   - Values shorter than `minLength` (default 6) are skipped.
#
# NEVER commit your real secrets.local — it is git-ignored for a reason.

my-internal-service-password
some-shared-literal-api-key
